rule merge_tracks:
    input:
        a=os.path.join(OUT, "mutalyzer_results.tsv"),
        b=os.path.join(OUT, "mutalyzer_results_NM_MANE.tsv"),
        c=os.path.join(OUT, "mutalyzer_results_NM_IDRefseq.tsv"),
    output:
        merged=os.path.join(OUT, "merged_variants.tsv"),
        unresolved=os.path.join(OUT, "unresolved_variants.tsv"),
        crosscheck=os.path.join(OUT, "crosscheck_disagreements.tsv"),
    params:
        logs=LOGS,
    conda:
        "envs/python.yaml"
    shell:
        f'TRACK_A="{{input.a}}" TRACK_B="{{input.b}}" TRACK_C="{{input.c}}" '
        f'OUT_MERGED="{{output.merged}}" OUT_UNRESOLVED="{{output.unresolved}}" OUT_CROSSCHECK="{{output.crosscheck}}" '
        f'LOG_PATH="{{params.logs}}/merge_tracks.log" '
        f'python "{script("Step7_Merging/merge_tracks.py")}"'


