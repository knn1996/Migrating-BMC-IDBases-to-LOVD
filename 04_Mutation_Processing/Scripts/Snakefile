    params:
        cache=config["mutalyzer"]["cache_dir"],
        logs=LOGS,
    conda:
        "envs/http.yaml"
    shell:
        f'INPUT_TSV="{{input}}" OUT_TSV="{{output}}" '
        f'CACHE_G_JSONL="{{params.cache}}/track_a_g.jsonl" CACHE_C_JSONL="{{params.cache}}/track_a_c.jsonl" '
        f'LOG_PATH="{{params.logs}}/mutalyzer_run.log" '
        f'python "{script("Step6_Mutalyzer/run_mutalyzer.py")}"'


rule mutalyzer_input_NM:
    input:
        mut=os.path.join(OUT, "all_mutations.tsv"),
        bed=os.path.join(BED, "hg38"),
    output:
        mane=os.path.join(OUT, "mutalyzer_input_NM_MANE.tsv"),
        mane_skip=os.path.join(OUT, "mutalyzer_input_NM_skipped_MANE.tsv"),
        legacy=os.path.join(OUT, "mutalyzer_input_NM_IDRefseq.tsv"),
        legacy_skip=os.path.join(OUT, "mutalyzer_input_NM_skipped_IDRefseq.tsv"),
    params:
        mane_nm=config["dna_seq"]["mane_nm"],
        idr_nm=config["dna_seq"]["idrefseq_nm"],
        mane_ng=config["dna_seq"]["mane_ng"],
    conda:
        "envs/python.yaml"
    shell:
        f'ALL_MUTATIONS_TSV="{{input.mut}}" BED_DIR="{{input.bed}}" '
        f'MANE_NM_DIR="{{params.mane_nm}}" IDREFSEQ_NM_DIR="{{params.idr_nm}}" MANE_NG_DIR="{{params.mane_ng}}" '
        f'OUT_TSV="{{output.mane}}" LOG_TSV="{{output.mane_skip}}" '
        f'python "{script("Step6_Mutalyzer/generate_mutalyzer_input_NM.py")}" --source MANE && '
        f'ALL_MUTATIONS_TSV="{{input.mut}}" BED_DIR="{{input.bed}}" '
        f'MANE_NM_DIR="{{params.mane_nm}}" IDREFSEQ_NM_DIR="{{params.idr_nm}}" MANE_NG_DIR="{{params.mane_ng}}" '
        f'OUT_TSV="{{output.legacy}}" LOG_TSV="{{output.legacy_skip}}" '
        f'python "{script("Step6_Mutalyzer/generate_mutalyzer_input_NM.py")}" --source IDRefseq'


