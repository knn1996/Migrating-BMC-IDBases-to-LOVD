def ng_fasta_for(gene):
    hits = sorted(glob.glob(os.path.join(DNA_SEQ["mane_ng"], f"{gene}_*.fasta")))
    return hits[0] if hits else ""


def ng_query(wc):
    return ancient(ng_fasta_for(wc.gene)
                   or os.path.join(DNA_SEQ["mane_ng"], f"{wc.gene}.fasta"))


def discover_genes():
    genes = []
    for d in sorted(os.listdir(IDBASE)):
        p = os.path.join(IDBASE, d)
        if os.path.isdir(p) and d.lower().endswith("base") and d.lower() != "immunomebase":
            genes.append(d[:-4].upper())
    return genes


def resolve_gene_set():
    """
    Resolve run_set to a concrete gene list and validate FASTA availability.

    A frozen list is authoritative: any gene in it that lacks an NG_ FASTA is a
    configuration error and aborts the run, because silently dropping a gene
    would change the analysed set without changing the config that documents
    it. Auto-discovery is permissive by default, since the idbase directory
    contains databases that never yielded extractable variants.
    """
    spec = config["gene_sets"][config["run_set"]]
    auto = spec == "auto"
    genes = discover_genes() if auto else [g.upper() for g in spec]

    missing = [g for g in genes if not ng_fasta_for(g)]
    if not missing:
        return genes

    if auto and config.get("skip_genes_without_ng_fasta", True):
        sys.stderr.write(
            f"[gene_set] run_set={config['run_set']!r}: skipping {len(missing)} "
            f"of {len(genes)} genes with no NG_ FASTA in {DNA_SEQ['mane_ng']}\n"
            f"[gene_set] skipped: {', '.join(sorted(missing))}\n"
        )
        return [g for g in genes if g not in set(missing)]

    raise WorkflowError(
        f"run_set={config['run_set']!r} names {len(missing)} gene(s) with no NG_ "
        f"FASTA in {DNA_SEQ['mane_ng']}: {', '.join(sorted(missing))}. "
        f"Download the missing references, or remove them from the gene set."
    )


GENES = resolve_gene_set()


def script(rel):
    return os.path.join(SCRIPTS, rel)


rule all:
    input:
        os.path.join(S7, "lovd_review.xlsx"),
        *([os.path.join(S2, "reference_check_source_2.tsv")] if config["optional"]["reference_confirm_source_2"] else []),
