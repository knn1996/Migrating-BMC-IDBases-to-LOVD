rule mutalyzer_input_NM:
    input:
        unpack(lambda wc: {"manifest": MANE_NM_MANIFEST} if config["rerun_downloads"] else {}),
        mut=os.path.join(S1A, "all_mutations.tsv"),
        bed=BED_HG38_IN,
    output:
        tsv=os.path.join(S6, "mutalyzer_input_NM_{source}.tsv"),
        skipped=os.path.join(S6, "mutalyzer_input_NM_skipped_{source}.tsv"),
    params:
        mane_nm=config["dna_seq"]["mane_nm"],
        idr_nm=config["dna_seq"]["idrefseq_nm"],
        mane_ng=config["dna_seq"]["mane_ng"],
    wildcard_constraints:
        source="MANE|IDRefseq",
    log:
        os.path.join(LOGS, "mutalyzer_input_NM_{source}.log"),
    conda:
        "envs/python.yaml"
    shell:
        f'ALL_MUTATIONS_TSV="{{input.mut}}" BED_DIR="{{input.bed}}" '
        f'MANE_NM_DIR="{{params.mane_nm}}" IDREFSEQ_NM_DIR="{{params.idr_nm}}" MANE_NG_DIR="{{params.mane_ng}}" '
        f'OUT_TSV="{{output.tsv}}" LOG_TSV="{{output.skipped}}" '
        f'python "{script("Step6_Mutalyzer/generate_mutalyzer_input_NM.py")}" '
        f'--source {{wildcards.source}} > "{{log}}" 2>&1'


TRACK_CACHE = {"MANE": "track_b_MANE", "IDRefseq": "track_c_IDRefseq"}


rule mutalyzer_track_NM:
    input:
        os.path.join(S6, "mutalyzer_input_NM_{source}.tsv"),
    output:
        os.path.join(S6, "mutalyzer_results_NM_{source}.tsv"),
    params:
        cache=config["mutalyzer"]["cache_dir"],
        logs=LOGS,
        mane_nm=config["dna_seq"]["mane_nm"],
        idr_nm=config["dna_seq"]["idrefseq_nm"],
        stem=lambda wc: TRACK_CACHE[wc.source],
        alt_p=os.path.join(config["mutalyzer"]["cache_dir"], "track_a_c.jsonl"),
    wildcard_constraints:
        source="MANE|IDRefseq",
    conda:
        "envs/http.yaml"
    shell:
        f'INPUT_TSV="{{input}}" OUT_TSV="{{output}}" '
        f'CACHE_JSONL="{{params.cache}}/{{params.stem}}.jsonl" '
        f'LOG_PATH="{{params.logs}}/mutalyzer_run_NM_{{wildcards.source}}.log" '
        f'MANE_NM_DIR="{{params.mane_nm}}" IDREFSEQ_NM_DIR="{{params.idr_nm}}" ALT_P_CACHE="{{params.alt_p}}" '
        f'python "{script("Step6_Mutalyzer/run_mutalyzer_NM.py")}" --source {{wildcards.source}}'


rule merge_tracks:
    input:
        a=os.path.join(S6, "mutalyzer_results.tsv"),
        b=os.path.join(S6, "mutalyzer_results_NM_MANE.tsv"),
        c=os.path.join(S6, "mutalyzer_results_NM_IDRefseq.tsv"),
        mut=os.path.join(S1A, "all_mutations.tsv"),
    output:
        merged=os.path.join(S7, "merged_variants.tsv"),
        unresolved=os.path.join(S7, "unresolved_variants.tsv"),
        crosscheck=os.path.join(S7, "crosscheck_disagreements.tsv"),
    params:
        logs=LOGS,
    conda:
        "envs/python.yaml"
    shell:
        f'TRACK_A="{{input.a}}" TRACK_B="{{input.b}}" TRACK_C="{{input.c}}" ALL_MUTATIONS_TSV="{{input.mut}}" '
        f'OUT_MERGED="{{output.merged}}" OUT_UNRESOLVED="{{output.unresolved}}" OUT_CROSSCHECK="{{output.crosscheck}}" '
        f'LOG_PATH="{{params.logs}}/merge_tracks.log" '
        f'python "{script("Step7_Merging/merge_tracks.py")}"'


