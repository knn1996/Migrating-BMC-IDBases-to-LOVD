# IDBases_Summary.csv is a two-pass bootstrap artefact, not a DAG product.
#
# lrg_index consumes it, but the rule that regenerates it (summary_v1) needs
# reference_summary.csv, which depends on LRG_with_NM.csv, which depends on
# lrg_index. That is a genuine cycle and Snakemake cannot express it. The file
# is therefore supplied as an ancient() external input and refreshed manually
# on a second pass once reference_summary.csv exists:
#
#   snakemake --use-conda -j1 Output/Step1b_RSG_Mapping/IDBases_Summary.v1.csv
#   cp Output/Step1b_RSG_Mapping/IDBases_Summary.v1.csv Output/IDBases_Summary.csv
#
# Only the uniprot and reference_sequence columns change between passes, and
# neither feeds back into variant calling, so a single pass is sufficient for
# the results reported in the thesis. Enable optional.rebuild_idbase_summary to
# have `rule all` build the v1 file for comparison.
rule summary_v1:
    input:
        idbase=IDBASE,
        ref=os.path.join(S2, "reference_summary.csv"),
    output:
        os.path.join(S1B, "IDBases_Summary.v1.csv"),
    log:
        os.path.join(LOGS, "build_idbase_summary.log"),
    conda:
        "envs/http.yaml"
    shell:
        f'IDBASE_DIR="{{input.idbase}}" REF_SUMMARY="{{input.ref}}" OUT_CSV="{{output}}" '
        f'python "{script("build_idbase_summary.py")}" > "{{log}}" 2>&1'


MANE_NG_MANIFEST = os.path.join(S2, "mane_ng_accessions.csv")

# download_mane_nm_sequences.py writes its manifest to LOG_DIR, not to
# Step1c_SeqDownload. The rule previously declared the Step1c path, which the
# script never creates, so download_nm could only ever fail on a missing output.
MANE_NM_MANIFEST = os.path.join(LOGS, "download_mane_nm_summary.csv")


def _fasta_count(d):
    return len(glob.glob(os.path.join(d, "*.fasta"))) + len(glob.glob(os.path.join(d, "*.fa")))


if not config["rerun_downloads"]:
    for _label, _dir in (("mane_ng", DNA_SEQ["mane_ng"]), ("mane_nm", DNA_SEQ["mane_nm"])):
        if _fasta_count(_dir) == 0:
            raise WorkflowError(
                f"rerun_downloads is false but {_label} directory {_dir} contains no "
                f"FASTA files. Set rerun_downloads: true to fetch them from NCBI, or "
                f"restore the directory."
            )


