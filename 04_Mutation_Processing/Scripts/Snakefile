rule make_blast_db:
    input:
        lambda wc: sorted(glob.glob(os.path.join(GENOME, BUILD_DIRS[wc.build], config["chr_glob"]))),
    output:
        protected(os.path.join(BLAST, "db", "{build}.nsq")),
    params:
        prefix=os.path.join(BLAST, "db", "{build}"),
        fa=os.path.join(BLAST, "db", "{build}.fa"),
    conda:
        "envs/blast.yaml"
    resources:
        mem_mb=config["resources"]["make_blast_db"]["mem_mb"],
        runtime=config["resources"]["make_blast_db"]["runtime"],
    shell:
        'cat {input} > "{params.fa}" && '
        'makeblastdb -in "{params.fa}" -dbtype nucl -out "{params.prefix}" && '
        'rm -f "{params.fa}"'


rule blast_gene:
    input:
        query=ng_query,
        db=os.path.join(BLAST, "db", "{build}.nsq"),
    output:
        os.path.join(BLAST, "{gene}_vs_{build}.txt"),
    params:
        db=os.path.join(BLAST, "db", "{build}"),
        outfmt=config["blast"]["outfmt"],
        evalue=config["blast"]["evalue"],
        maxhits=config["blast"]["max_target_seqs"],
    conda:
        "envs/blast.yaml"
    threads:
        config["resources"]["blast_gene"]["threads"]
    resources:
        mem_mb=config["resources"]["blast_gene"]["mem_mb"],
        runtime=config["resources"]["blast_gene"]["runtime"],
    shell:
        'blastn -query "{input.query}" -db "{params.db}" -out "{output}" '
        '-outfmt "{params.outfmt}" -num_threads {threads} '
        '-evalue {params.evalue} -max_target_seqs {params.maxhits}'


rule summarize_blast:
    input:
        expand(os.path.join(BLAST, "{gene}_vs_{build}.txt"), gene=GENES, build=BUILDS),
    output:
        os.path.join(OUT, "blast_first_hits_source_IDRefseq.tsv"),
    conda:
        "envs/python.yaml"
    shell:
        f'IN_DIR="{BLAST}" OUT_FILE="{{output}}" '
        f'bash "{script("Step3_BLAST/summarize_blast_first_hits.sh")}"'


