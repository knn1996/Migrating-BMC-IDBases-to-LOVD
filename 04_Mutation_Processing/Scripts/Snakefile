BED_RAW      = config["bed_raw_dir"]
BED_RAW_HG38 = os.path.join(BED_RAW, "hg38")

if config["rerun_bed"]:

    # generate_bed declares a manifest outside BED_RAW rather than the directory
    # itself: liftover writes into BED_RAW/hg38, and Snakemake rejects an output
    # that is a child of another rule's output directory.
    rule generate_bed:
        input:
            mut=os.path.join(S1A, "all_mutations.tsv"),
            blast=BLAST_HITS_IN,
        output:
            os.path.join(OUT, "bed_raw_manifest.txt"),
        params:
            bed=BED_RAW,
        conda:
            "envs/python.yaml"
        shell:
            f'MUTATIONS_TSV="{{input.mut}}" BLAST_HITS="{{input.blast}}" '
            f'BED_DIR="{{params.bed}}" LOG_DIR="{LOGS}" '
            f'python "{script("Step4_BED/generate_bed.py")}" --source IDRefseq && '
            f'ls -1 "{{params.bed}}"/*.BED > "{{output}}"'

    rule liftover:
        input:
            os.path.join(OUT, "bed_raw_manifest.txt"),
        output:
            directory(BED_RAW_HG38),
        params:
            chains=os.path.join(SCRIPTS, "Step5_LiftOver"),
            bed=BED_RAW,
        conda:
            "envs/ucsc.yaml"
        shell:
            f'IN_DIR="{{params.bed}}" OUT_DIR="{{output}}" CHAIN_DIR="{{params.chains}}" '
            f'bash "{script("Step5_LiftOver/liftover.sh")}"'

    rule filter_bed_hg18:
        input:
            raw=os.path.join(OUT, "bed_raw_manifest.txt"),
            summary=os.path.join(S2, "reference_summary.csv"),
        output:
            directory(S4),
        params:
            bed=BED_RAW,
        conda:
            "envs/python.yaml"
        shell:
            f'REF_SUMMARY="{{input.summary}}" IN_DIR="{{params.bed}}" OUT_DIR="{{output}}" '
            f'OUT_EXCLUDED="{os.path.join(OUT, "excluded_accessions_hg18.tsv")}" '
            f'python "{script("Step4_BED/filter_bed.py")}"'

    rule filter_bed_hg38:
        input:
            raw=BED_RAW_HG38,
            summary=os.path.join(S2, "reference_summary.csv"),
        output:
            directory(S5),
        conda:
            "envs/python.yaml"
        shell:
            f'REF_SUMMARY="{{input.summary}}" IN_DIR="{{input.raw}}" OUT_DIR="{{output}}" '
            f'OUT_EXCLUDED="{os.path.join(OUT, "excluded_accessions_hg38.tsv")}" '
            f'python "{script("Step4_BED/filter_bed.py")}"'

else:

    if not glob.glob(os.path.join(S5, "*.BED")):
        raise WorkflowError(
            f"rerun_bed is false but {S5} contains no BED files. Set rerun_bed: true "
            f"to regenerate the BED and liftover tiers from {BED_RAW}."
        )


BED_HG38_IN = S5 if config["rerun_bed"] else ancient(S5)


