rule reference_confirm_source_2:
    input:
        mut=os.path.join(S1A, "all_mutations.tsv"),
    output:
        os.path.join(S2, "reference_check_source_2.tsv"),
    params:
        seq=REF_SEQ["source2_reference"],
    conda:
        "envs/python.yaml"
    shell:
        f'SEQ_DIR="{{params.seq}}" MUTATIONS_TSV="{{input.mut}}" OUT_PATH="{{output}}" '
        f'python "{script("Step2_RefCheck/reference_confirm_source_2.py")}"'


