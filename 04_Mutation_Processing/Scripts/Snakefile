import os
import glob

configfile: "config/config.yaml"

THESIS = config["thesis_dir"]
PROC = os.path.join(THESIS, config["proc_subdir"])
IDBASE = os.path.join(THESIS, config["idbase_subdir"])
SCRIPTS = workflow.basedir

OUT = config["output_root"]
SEQ = config["seq_root"]
BLAST = config["blast_root"]
BED = config["bed_root"]
LOGS = config["logs_root"]

GENOME = config["genome_dir"]
BUILDS = config["builds"]
BUILD_DIRS = config["build_dirs"]

DNA_SEQ = config["dna_seq"]
REF_SEQ = config["ref_seq"]
INPUTS = config["inputs"]


def ng_query(wc):
    hits = sorted(glob.glob(os.path.join(DNA_SEQ["mane_ng"], f"{wc.gene}_*.fasta")))
    return hits[0] if hits else os.path.join(DNA_SEQ["mane_ng"], f"{wc.gene}.fasta")


def discover_genes():
    genes = []
    for d in sorted(os.listdir(IDBASE)):
        p = os.path.join(IDBASE, d)
        if os.path.isdir(p) and d.lower().endswith("base") and d.lower() != "immunomebase":
            genes.append(d[:-4].upper() if d.lower().endswith("base") else d.upper())
    return genes


_set = config["gene_sets"][config["run_set"]]
GENES = discover_genes() if _set == "auto" else [g.upper() for g in _set]


def script(rel):
    return os.path.join(SCRIPTS, rel)


rule all:
    input:
        os.path.join(OUT, "lovd_review.xlsx"),
        *([os.path.join(OUT, "reference_check_source_2.tsv")] if config["optional"]["reference_confirm_source_2"] else []),
        *([os.path.join(OUT, "lrg_offset_results_NM.csv")] if config["optional"]["find_lrg_offset_NM"] else []),
        *([os.path.join(OUT, "gene_confidence_NG_IDRefseq.csv")] if config["optional"]["confidence_analysis"] else []),


