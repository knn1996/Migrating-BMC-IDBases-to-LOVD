BLAST_DB_EXT = [".nhr", ".nin", ".nsq"]


rule make_blast_db:
    input:
        lambda wc: sorted(glob.glob(os.path.join(GENOME, BUILD_DIRS[wc.build], config["chr_glob"]))),
    output:
        protected(multiext(os.path.join(S3, "db", "{build}"), *BLAST_DB_EXT)),
    params:
        prefix=os.path.join(S3, "db", "{build}"),
        fa=os.path.join(S3, "db", "{build}.fa"),
    log:
        os.path.join(LOGS, "make_blast_db_{build}.log"),
    conda:
        "envs/blast.yaml"
    resources:
        mem_mb=config["resources"]["make_blast_db"]["mem_mb"],
        runtime=config["resources"]["make_blast_db"]["runtime"],
    shell:
        '( cat {input} > "{params.fa}" && '
        'makeblastdb -in "{params.fa}" -dbtype nucl -out "{params.prefix}" && '
        'rm -f "{params.fa}" ) > "{log}" 2>&1'


rule blast_gene:
    input:
        unpack(lambda wc: {"manifest": MANE_NG_MANIFEST} if config["rerun_downloads"] else {}),
        query=ng_query,
        db=multiext(os.path.join(S3, "db", "{build}"), *BLAST_DB_EXT),
    output:
        os.path.join(S3, "{gene}_vs_{build}.txt"),
    params:
        db=os.path.join(S3, "db", "{build}"),
        outfmt=config["blast"]["outfmt"],
        evalue=config["blast"]["evalue"],
        maxhits=config["blast"]["max_target_seqs"],
    log:
        os.path.join(LOGS, "blast_{gene}_vs_{build}.log"),
    conda:
        "envs/blast.yaml"
    threads:
        config["resources"]["blast_gene"]["threads"]
    resources:
        mem_mb=config["resources"]["blast_gene"]["mem_mb"],
        runtime=config["resources"]["blast_gene"]["runtime"],
    shell:
        'blastn -query "{input.query}" -db "{params.db}" -out "{output}" '
        '-outfmt "{params.outfmt}" -num_threads {threads} '
        '-evalue {params.evalue} -max_target_seqs {params.maxhits} 2> "{log}"'


BLAST_HITS = os.path.join(S3, "blast_first_hits_source_IDRefseq.tsv")

if config["rerun_blast"]:

    rule summarize_blast:
        input:
            expand(os.path.join(S3, "{gene}_vs_{build}.txt"), gene=GENES, build=BUILDS),
        output:
            BLAST_HITS,
        log:
            os.path.join(LOGS, "summarize_blast.log"),
        conda:
            "envs/python.yaml"
        shell:
            f'IN_DIR="{S3}" OUT_FILE="{{output}}" '
            f'bash "{script("Step3_BLAST/summarize_blast_first_hits.sh")}" > "{{log}}" 2>&1'

else:

    if not os.path.exists(BLAST_HITS):
        raise WorkflowError(
            f"rerun_blast is false but {BLAST_HITS} does not exist. Either restore "
            f"the summarised BLAST table or set rerun_blast: true in config to "
            f"rebuild the BLAST tier from the reference genomes."
        )


BLAST_HITS_IN = BLAST_HITS if config["rerun_blast"] else ancient(BLAST_HITS)


